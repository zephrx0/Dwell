<Window x:Class="Dwell.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Dwell.ViewModels" xmlns:views="using:Dwell.Views" xmlns:notify="using:H.NotifyIcon" xmlns:automation="using:Microsoft.UI.Xaml.Automation">
  <UserControl x:Name="AdaptiveHost">
    <UserControl.Resources>
      <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
          <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="DwellControlBorderBrush" Color="#8392A4" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#DCE6F0" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#D1DFEC" />
            <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
            <StaticResource x:Key="NavigationViewContentGridBorderBrush" ResourceKey="DwellBorderBrush" />
            <StaticResource x:Key="NavigationViewSelectionIndicatorForeground" ResourceKey="DwellCommunicationBrush" />
            <StaticResource x:Key="SelectorBarItemPillFill" ResourceKey="DwellCommunicationBrush" />
            <StaticResource x:Key="ButtonBorderBrush" ResourceKey="DwellControlBorderBrush" />
            <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="DwellControlBorderBrush" />
            <StaticResource x:Key="TextControlBorderBrush" ResourceKey="DwellControlBorderBrush" />
            <StaticResource x:Key="ExpanderHeaderBorderBrush" ResourceKey="DwellBorderBrush" />
          </ResourceDictionary>
          <ResourceDictionary x:Key="Dark">
            <StaticResource x:Key="NavigationViewContentBackground" ResourceKey="LayerFillColorDefaultBrush" />
            <StaticResource x:Key="NavigationViewItemBackgroundSelected" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="NavigationViewItemBackgroundSelectedPointerOver" ResourceKey="SubtleFillColorTertiaryBrush" />
            <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
            <StaticResource x:Key="NavigationViewContentGridBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
            <StaticResource x:Key="NavigationViewSelectionIndicatorForeground" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="SelectorBarItemPillFill" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="ButtonBorderBrush" ResourceKey="ControlElevationBorderBrush" />
            <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="ControlElevationBorderBrush" />
            <StaticResource x:Key="TextControlBorderBrush" ResourceKey="TextControlElevationBorderBrush" />
            <StaticResource x:Key="ExpanderHeaderBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
          </ResourceDictionary>
          <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <StaticResource x:Key="NavigationViewItemBackgroundSelected" ResourceKey="SystemControlHighlightListLowRevealBackgroundBrush" />
            <StaticResource x:Key="NavigationViewItemBackgroundSelectedPointerOver" ResourceKey="SystemControlHighlightListLowRevealBackgroundBrush" />
            <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="SystemControlBackgroundBaseLowBrush" />
            <StaticResource x:Key="NavigationViewContentGridBorderBrush" ResourceKey="SystemControlTransparentBrush" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="SelectorBarItemPillFill" Color="{ThemeResource SystemColorHighlightColor}" />
            <StaticResource x:Key="ButtonBorderBrush" ResourceKey="SystemControlForegroundTransparentBrush" />
            <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="SystemControlForegroundBaseMediumBrush" />
            <StaticResource x:Key="TextControlBorderBrush" ResourceKey="SystemControlForegroundBaseMediumBrush" />
            <StaticResource x:Key="ExpanderHeaderBorderBrush" ResourceKey="SystemColorButtonTextColorBrush" />
          </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
        <Style x:Key="SettingsRowStyle" TargetType="Grid">
          <Setter Property="MinHeight" Value="56" />
          <Setter Property="Padding" Value="16,10" />
          <Setter Property="ColumnSpacing" Value="12" />
        </Style>
        <Style x:Key="SettingsLabelStyle" TargetType="TextBlock">
          <Setter Property="VerticalAlignment" Value="Center" />
          <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
      </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="Root">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup>
          <VisualState x:Name="Compact">
            <VisualState.Setters>
              <Setter Target="DashboardLeft.Width" Value="*" /><Setter Target="DashboardRight.Width" Value="0" />
              <Setter Target="Dashboard.ColumnSpacing" Value="0" />
            </VisualState.Setters>
          </VisualState>
          <VisualState x:Name="Wide">
            <VisualState.Setters>
              <Setter Target="DashboardLeft.Width" Value="5*" /><Setter Target="DashboardRight.Width" Value="4*" />
              <Setter Target="Dashboard.ColumnSpacing" Value="16" />
              <Setter Target="AppSection.(Grid.Row)" Value="0" /><Setter Target="AppSection.(Grid.Column)" Value="1" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Grid x:Name="FallbackSurface" Grid.RowSpan="2" Background="{ThemeResource DwellWindowBrush}" />
      <TitleBar x:Name="AppTitleBar" Visibility="Collapsed">
        <TitleBar.IconSource><ImageIconSource ImageSource="ms-appx:///Assets/Dwell.png" /></TitleBar.IconSource>
      </TitleBar>
      <NavigationView x:Name="Navigation" Grid.Row="1" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" PaneDisplayMode="Auto" OpenPaneLength="224" CompactModeThresholdWidth="0" ExpandedModeThresholdWidth="980" SelectionChanged="NavigationChanged">
        <NavigationView.MenuItems>
          <NavigationViewItem x:Name="OverviewItem" x:Uid="OverviewNav" Tag="overview" Icon="ViewAll" IsSelected="True" />
          <NavigationViewItem x:Name="ActivityItem" Tag="activity" Icon="Clock" />
          <NavigationViewItem x:Name="RulesItem" Tag="rules" Icon="Manage" />
          <NavigationViewItem x:Name="ExcludedAppsItem" Tag="excluded" Icon="View" />
          <NavigationViewItem x:Name="PowerItem" Tag="power">
            <NavigationViewItem.Icon><FontIcon Glyph="&#xE945;" /></NavigationViewItem.Icon>
          </NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems><NavigationViewItem x:Name="SettingsItem" x:Uid="SettingsNav" Tag="settings" Icon="Setting" /></NavigationView.FooterMenuItems>
        <Grid>
          <ScrollViewer x:Name="OverviewScroll" MaxWidth="{StaticResource DwellPageMaxWidth}" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Padding="{StaticResource DwellPagePadding}" Spacing="12" DataContext="{x:Bind Overview}">
              <StackPanel Spacing="8">
                <views:InlineWrapPanel ColumnSpacing="12">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button x:Name="PreviousButton" Command="{Binding PreviousCommand}" Width="30" Height="32" Padding="0"><FontIcon Glyph="&#xE76B;" FontSize="12" /></Button>
                    <TextBlock Text="{Binding PeriodTitle}" VerticalAlignment="Center" />
                    <Button x:Name="NextButton" Command="{Binding NextCommand}" IsEnabled="{Binding CanGoForward}" Width="30" Height="32" Padding="0"><FontIcon Glyph="&#xE76C;" FontSize="12" /></Button>
                  </StackPanel>
                  <SelectorBar x:Name="PeriodSwitch" SelectionChanged="PeriodChanged">
                    <SelectorBarItem x:Name="DayTab" x:Uid="DayTab" IsSelected="True" Padding="8,4" />
                    <SelectorBarItem x:Name="WeekTab" x:Uid="WeekTab" Padding="8,4" />
                  </SelectorBar>
                  <Button Style="{StaticResource SubtleButtonStyle}" Content="{Binding CurrentPeriodLabel}" Command="{Binding CurrentPeriodCommand}" Height="32" Padding="8,4"
                          Visibility="{Binding CanGoForward, Converter={StaticResource BoolVisibility}}" />
                </views:InlineWrapPanel>
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding SummaryCaption}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  <TextBlock Text="{Binding TotalTime}" FontSize="36" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding AverageTime}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{Binding IsWeek, Converter={StaticResource BoolVisibility}}" />
                  <TextBlock Text="{Binding Comparison}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="{Binding Comparison, Converter={StaticResource TextVisibility}}" />
                  <TextBlock x:Name="TrackingStatusText" Visibility="{Binding Text, ElementName=TrackingStatusText, Converter={StaticResource TextVisibility}}" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                </StackPanel>
              </StackPanel>
              <Grid x:Name="Dashboard" RowSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="DashboardLeft" Width="*" /><ColumnDefinition x:Name="DashboardRight" Width="0" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Spacing="8">
                  <Border Style="{StaticResource DwellCardStyle}" Padding="8" Background="{ThemeResource DwellChartBrush}"
                          Visibility="{Binding HasData, Converter={StaticResource BoolVisibility}}">
                    <StackPanel Spacing="4">
                      <ContentControl x:Name="ChartHost" HorizontalContentAlignment="Stretch" />
                      <ItemsControl ItemsSource="{Binding Categories}" Padding="4,0,4,4">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><views:InlineWrapPanel ColumnSpacing="12" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Grid Width="6" Height="6" VerticalAlignment="Center">
                          <Ellipse Fill="{ThemeResource DwellCommunicationBrush}" Visibility="{Binding Category, Converter={StaticResource CategoryVisibility}, ConverterParameter=Communication}" />
                          <Ellipse Fill="{ThemeResource DwellProductivityBrush}" Visibility="{Binding Category, Converter={StaticResource CategoryVisibility}, ConverterParameter=Productivity}" />
                          <Ellipse Fill="{ThemeResource DwellEntertainmentBrush}" Visibility="{Binding Category, Converter={StaticResource CategoryVisibility}, ConverterParameter=Entertainment}" />
                          <Ellipse Fill="{ThemeResource DwellGamesBrush}" Visibility="{Binding Category, Converter={StaticResource CategoryVisibility}, ConverterParameter=Games}" />
                          <Ellipse Fill="{ThemeResource DwellOtherBrush}" Visibility="{Binding Category, Converter={StaticResource CategoryVisibility}, ConverterParameter=Other}" />
                        </Grid>
                        <TextBlock Text="{Binding Name}" FontSize="12" />
                        <TextBlock Text="{Binding Time}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                  <TextBlock x:Name="EmptyMessage" x:Uid="EmptyState" Margin="0,8" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{Binding HasData, Converter={StaticResource BoolVisibility}, ConverterParameter=Invert}" />
                  <ItemsControl ItemsSource="{Binding PowerMetrics}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><views:InlineWrapPanel ColumnSpacing="16" RowSpacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <FontIcon Glyph="{Binding Glyph}" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" automation:AutomationProperties.AccessibilityView="Raw" />
                          <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Value}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              <StackPanel x:Name="AppSection" Grid.Row="1" Spacing="12">
                <StackPanel Spacing="8" Visibility="{Binding HasApps, Converter={StaticResource BoolVisibility}}">
                <Border Style="{StaticResource DwellCardStyle}">
                  <StackPanel>
                    <TextBlock x:Name="MostUsedHeading" x:Uid="MostUsedTitle" FontSize="16" FontWeight="SemiBold" Margin="16,8,16,2" />
                    <ItemsControl ItemsSource="{x:Bind Overview.Apps}">
                  <ItemsControl.Resources>
                    <StaticResource x:Key="ExpanderHeaderBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ExpanderContentBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ExpanderHeaderBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                    <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
                  </ItemsControl.Resources>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AppUsageViewModel"><StackPanel>
                      <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" CornerRadius="0" BorderThickness="0">
                        <Expander.Header>
                          <Grid ColumnSpacing="12" Padding="0,4" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid VerticalAlignment="Center"><FontIcon Glyph="&#xE71D;" FontSize="22" Visibility="{Binding HasIcon, Converter={StaticResource BoolVisibility}, ConverterParameter=Invert}" /><Image Width="28" Height="28" Source="{Binding Icon}" Visibility="{Binding HasIcon, Converter={StaticResource BoolVisibility}}" /></Grid>
                            <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Name}" /><views:InlineWrapPanel ColumnSpacing="12" RowSpacing="0"><TextBlock Text="{Binding ScreenTime}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /><TextBlock Text="{Binding BackgroundTime}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></views:InlineWrapPanel></StackPanel>
                          </Grid>
                        </Expander.Header>
                        <StackPanel Spacing="8" Padding="40,0,0,8">
                          <StackPanel Orientation="Horizontal" Spacing="32" Visibility="{Binding HasResources, Converter={StaticResource BoolVisibility}}"><StackPanel Spacing="4"><TextBlock Text="{Binding CpuLabel}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{Binding Cpu}" FontSize="20" /></StackPanel><StackPanel Spacing="4"><TextBlock Text="{Binding MemoryLabel}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="{Binding Memory}" FontSize="20" /></StackPanel></StackPanel>
                          <views:InlineWrapPanel ColumnSpacing="8" RowSpacing="4">
                            <Button Content="{Binding HistoryLabel}" Command="{Binding ViewHistoryCommand}" />
                            <Button Content="{Binding CategoryMenuLabel}" automation:AutomationProperties.Name="{Binding CategoryActionLabel}"><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="{Binding CategoryNames[0]}" Command="{Binding SetCategoryCommand}" CommandParameter="0" /><MenuFlyoutItem Text="{Binding CategoryNames[1]}" Command="{Binding SetCategoryCommand}" CommandParameter="1" /><MenuFlyoutItem Text="{Binding CategoryNames[2]}" Command="{Binding SetCategoryCommand}" CommandParameter="2" /><MenuFlyoutItem Text="{Binding CategoryNames[3]}" Command="{Binding SetCategoryCommand}" CommandParameter="3" /><MenuFlyoutItem Text="{Binding CategoryNames[4]}" Command="{Binding SetCategoryCommand}" CommandParameter="4" /></MenuFlyout></Button.Flyout></Button>
                            <Button Content="{Binding ExcludeLabel}" Style="{StaticResource SubtleButtonStyle}" Click="ExcludeAppClicked" />
                          </views:InlineWrapPanel>
                        </StackPanel>
                      </Expander>
                      <Border Height="1" Margin="56,0,16,0" Background="{ThemeResource DwellDividerBrush}" />
                    </StackPanel></DataTemplate>
                  </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
                <Button x:Name="MoreButton" x:Uid="ShowMore" Style="{StaticResource SubtleButtonStyle}" Command="{x:Bind Overview.ShowMoreCommand}" Visibility="{Binding CanShowMore, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Left" Padding="8,4" />
                </StackPanel>
                <StackPanel Spacing="8" Visibility="{Binding HasData, Converter={StaticResource BoolVisibility}}">
                  <Border Height="1" Background="{ThemeResource DwellDividerBrush}" />
                  <ItemsControl ItemsSource="{Binding Metrics}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><views:InlineWrapPanel ColumnSpacing="16" RowSpacing="8" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Spacing="2" MinWidth="80">
                          <TextBlock Text="{Binding Label}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                          <TextBlock Text="{Binding Value}" FontSize="16" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
              </Grid>
              <TextBlock Text="{Binding Error}" Visibility="{Binding Error, Converter={StaticResource TextVisibility}}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
            </StackPanel>
          </ScrollViewer>
          <views:ActivityView x:Name="HistoryPage" MaxWidth="{StaticResource DwellPageMaxWidth}" DataContext="{x:Bind Activity}" Visibility="Collapsed" />
          <views:RulesView x:Name="LimitsPage" MaxWidth="{StaticResource DwellPageMaxWidth}" DataContext="{x:Bind Rules}" Visibility="Collapsed" />
          <ContentControl x:Name="PowerHost" MaxWidth="{StaticResource DwellPageMaxWidth}" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
          <ScrollViewer x:Name="ExcludedAppsScroll" MaxWidth="{StaticResource DwellPageMaxWidth}" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Padding="{StaticResource DwellPagePadding}" Spacing="12" DataContext="{x:Bind ExcludedApps}">
              <TextBlock x:Name="ExcludedAppsHeading" FontSize="24" FontWeight="SemiBold" />
              <TextBlock x:Name="ExcludedAppsEmpty" Visibility="{Binding HasApps, Converter={StaticResource BoolVisibility}, ConverterParameter=Invert}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding Apps}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ExcludedAppItem">
                    <Border Style="{StaticResource DwellCardStyle}" Margin="0,0,0,6">
                      <Grid ColumnSpacing="12" Padding="16,10" MinHeight="56">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Name}" />
                          <TextBlock Text="{Binding Executable}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{Binding RestoreLabel}" Click="RestoreAppClicked" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding Error}" Visibility="{Binding Error, Converter={StaticResource TextVisibility}}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer x:Name="SettingsScroll" MaxWidth="{StaticResource DwellPageMaxWidth}" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Padding="{StaticResource DwellPagePadding}" Spacing="12" DataContext="{x:Bind Settings}">
              <TextBlock x:Name="SettingsHeading" x:Uid="SettingsTitle" FontSize="24" FontWeight="SemiBold" />
              <Border Style="{StaticResource DwellCardStyle}">
                <StackPanel>
                  <Grid Style="{StaticResource SettingsRowStyle}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="ThemeLabel" Style="{StaticResource SettingsLabelStyle}" />
                    <ComboBox x:Name="ThemeCombo" Grid.Column="1" Width="160" VerticalAlignment="Center"
                              automation:AutomationProperties.LabeledBy="{Binding ElementName=ThemeLabel}" SelectedIndex="{x:Bind Settings.ThemeIndex, Mode=TwoWay}">
                      <ComboBoxItem x:Name="SystemThemeItem" x:Uid="SystemTheme" /><ComboBoxItem x:Name="LightThemeItem" x:Uid="LightTheme" /><ComboBoxItem x:Name="DarkThemeItem" x:Uid="DarkTheme" />
                    </ComboBox>
                  </Grid>
                  <Border Height="1" Background="{ThemeResource DwellDividerBrush}" />
                  <Grid Style="{StaticResource SettingsRowStyle}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="LanguageLabel" Style="{StaticResource SettingsLabelStyle}" />
                    <ComboBox x:Name="LanguageCombo" Grid.Column="1" Width="160" VerticalAlignment="Center"
                              automation:AutomationProperties.LabeledBy="{Binding ElementName=LanguageLabel}" SelectedIndex="{x:Bind Settings.LanguageIndex, Mode=TwoWay}">
                      <ComboBoxItem x:Name="SystemLanguageItem" x:Uid="SystemLanguage" /><ComboBoxItem x:Uid="RussianLanguage" /><ComboBoxItem x:Uid="EnglishLanguage" />
                    </ComboBox>
                  </Grid>
                  <Border Height="1" Background="{ThemeResource DwellDividerBrush}" />
                  <Grid Style="{StaticResource SettingsRowStyle}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="IdleLabel" Style="{StaticResource SettingsLabelStyle}" />
                    <NumberBox x:Name="IdleInput" Grid.Column="1" Width="160" VerticalAlignment="Center" Minimum="1" Maximum="60"
                               SmallChange="1" SpinButtonPlacementMode="Inline" automation:AutomationProperties.LabeledBy="{Binding ElementName=IdleLabel}"
                               Value="{x:Bind Settings.IdleMinutes, Mode=TwoWay}" />
                  </Grid>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource DwellCardStyle}">
                <Grid Style="{StaticResource SettingsRowStyle}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="StartupLabel" Style="{StaticResource SettingsLabelStyle}" />
                    <HyperlinkButton x:Name="StartupSettingsLink" x:Uid="StartupSettingsLink" Click="OpenStartupSettings"
                                     Padding="0,4" HorizontalAlignment="Left" />
                  </StackPanel>
                  <ToggleSwitch x:Name="StartupSwitch" Grid.Column="1" MinWidth="0" VerticalAlignment="Center"
                                automation:AutomationProperties.LabeledBy="{Binding ElementName=StartupLabel}"
                                IsOn="{x:Bind Settings.AutoStart, Mode=TwoWay}" OnContent="" OffContent="" />
                </Grid>
              </Border>
              <TextBlock Text="{Binding Error}" Visibility="{Binding Error, Converter={StaticResource TextVisibility}}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
              <Border Style="{StaticResource DwellCardStyle}">
                <StackPanel Spacing="8" Padding="16,12">
                  <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="UpdatesHeading" Style="{StaticResource SettingsLabelStyle}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                      <ProgressRing x:Name="UpdateProgress" Width="18" Height="18" Visibility="Collapsed" />
                      <Button x:Name="UpdateButton" Click="UpdateClicked" />
                    </StackPanel>
                  </Grid>
                  <TextBlock x:Name="UpdateStatus" Visibility="{Binding Text, ElementName=UpdateStatus, Converter={StaticResource TextVisibility}}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" automation:AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </NavigationView>
      <notify:TaskbarIcon Width="0" Height="0" x:Name="TrayIcon" ToolTipText="Dwell" NoLeftClickDelay="True">
        <notify:TaskbarIcon.ContextFlyout>
          <MenuFlyout>
            <MenuFlyoutItem x:Name="TrayOpen" x:Uid="TrayOpen" />
            <MenuFlyoutItem x:Name="TrayPause" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem x:Name="TrayExit" x:Uid="TrayExit" />
          </MenuFlyout>
        </notify:TaskbarIcon.ContextFlyout>
      </notify:TaskbarIcon>
    </Grid>
  </UserControl>
</Window>
