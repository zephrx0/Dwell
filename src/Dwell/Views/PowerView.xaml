<UserControl x:Class="Dwell.Views.PowerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI" xmlns:views="using:Dwell.Views">
  <UserControl.Resources>
    <DataTemplate x:Key="SensorRowTemplate" x:DataType="views:PowerSensorRow">
      <Grid ColumnSpacing="12" Padding="8,6" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DwellDividerBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="82" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
        <StackPanel Spacing="2">
          <TextBlock Text="{x:Bind Device}" Visibility="{x:Bind DeviceVisibility}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Device}" />
          <TextBlock Text="{x:Bind Sensor}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Sensor}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{x:Bind Wattage}" ToolTipService.ToolTip="{x:Bind MeasurementDetail}"
                   HorizontalAlignment="Right" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{x:Bind Included}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <Grid>
  <StackPanel Opacity="0" IsHitTestVisible="False" Width="0" Height="0">
    <Rectangle x:Name="AxisSwatch" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
    <Rectangle x:Name="GridSwatch" Fill="{ThemeResource DwellDividerBrush}" />
    <Rectangle x:Name="Swatch0" Fill="{ThemeResource DwellCommunicationBrush}" />
    <Rectangle x:Name="Swatch1" Fill="{ThemeResource DwellProductivityBrush}" />
    <Rectangle x:Name="Swatch2" Fill="{ThemeResource DwellEntertainmentBrush}" />
    <Rectangle x:Name="Swatch3" Fill="{ThemeResource DwellGamesBrush}" />
    <Rectangle x:Name="Swatch4" Fill="{ThemeResource DwellOtherBrush}" />
    <Rectangle x:Name="TooltipBackgroundSwatch" Fill="{ThemeResource DwellWindowBrush}" />
    <Rectangle x:Name="TooltipTextSwatch" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
  </StackPanel>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Padding="{StaticResource DwellPagePadding}" Spacing="16">
      <TextBlock x:Name="Heading" FontSize="24" FontWeight="SemiBold" />
      <StackPanel Spacing="8">
        <views:InlineWrapPanel ColumnSpacing="24" RowSpacing="8">
          <StackPanel Spacing="4">
          <TextBlock x:Name="Total" FontSize="32" FontWeight="SemiBold" />
          <TextBlock x:Name="Scope" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
          <HyperlinkButton x:Name="CpuPowerHelp" Visibility="Collapsed" Padding="0,0,0,2" />
          </StackPanel>
          <ComboBox x:Name="ChartSource" Width="270" SelectionChanged="ChartSourceChanged">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="views:PowerChartChoice">
                <TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </views:InlineWrapPanel>
        <Border Style="{StaticResource DwellCardStyle}" Background="{ThemeResource DwellChartBrush}">
          <Grid Padding="8,8,8,0" Height="280">
            <lvc:CartesianChart x:Name="Chart" Visibility="Collapsed" Background="{ThemeResource DwellChartBrush}"
                                LegendPosition="Hidden" TooltipPosition="Top" FindingStrategy="CompareOnlyXTakeClosest" AnimationsSpeed="0:0:0" />
            <TextBlock x:Name="WaitMessage" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
          </Grid>
        </Border>
          <TextBlock x:Name="WindowLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Spacing="8">
        <TextBlock x:Name="SensorsHeading" FontSize="18" FontWeight="SemiBold" />
        <Grid ColumnSpacing="12" Padding="8,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="82" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
          <TextBlock x:Name="DeviceHeading" />
          <TextBlock x:Name="WattsHeading" Grid.Column="1" HorizontalAlignment="Right" />
          <TextBlock x:Name="IncludedHeading" Grid.Column="2" HorizontalAlignment="Center" />
        </Grid>
        <ItemsControl x:Name="Processors">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="views:PowerProcessorRow">
              <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                <Expander.Header>
                  <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="82" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                      <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                      <TextBlock Text="{x:Bind Sensor, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis"
                                 ToolTipService.ToolTip="{x:Bind MeasurementDetail, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{x:Bind Wattage, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind MeasurementDetail, Mode=OneWay}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{x:Bind Included, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  </Grid>
                </Expander.Header>
                <ItemsControl ItemsSource="{x:Bind Details, Mode=OneWay}" ItemTemplate="{StaticResource SensorRowTemplate}" />
              </Expander>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl x:Name="Sensors" ItemTemplate="{StaticResource SensorRowTemplate}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
  </Grid>
</UserControl>
