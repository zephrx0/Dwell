<UserControl x:Class="Dwell.Views.PowerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI" xmlns:views="using:Dwell.Views">
  <Grid>
  <StackPanel Opacity="0" IsHitTestVisible="False" Width="0" Height="0">
    <Rectangle x:Name="AxisSwatch" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
    <Rectangle x:Name="GridSwatch" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
    <Rectangle x:Name="Swatch0" Fill="{ThemeResource DwellCommunicationBrush}" />
    <Rectangle x:Name="Swatch1" Fill="{ThemeResource DwellProductivityBrush}" />
    <Rectangle x:Name="Swatch2" Fill="{ThemeResource DwellEntertainmentBrush}" />
    <Rectangle x:Name="Swatch3" Fill="{ThemeResource DwellGamesBrush}" />
    <Rectangle x:Name="Swatch4" Fill="{ThemeResource DwellOtherBrush}" />
    <Rectangle x:Name="TooltipBackgroundSwatch" Fill="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
    <Rectangle x:Name="TooltipTextSwatch" Fill="{ThemeResource TextFillColorPrimaryBrush}" />
  </StackPanel>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Padding="16,12,16,16" Spacing="16">
      <TextBlock x:Name="Heading" FontSize="24" FontWeight="SemiBold" />
      <StackPanel Spacing="8">
        <views:InlineWrapPanel ColumnSpacing="24" RowSpacing="8">
          <StackPanel Spacing="4">
          <TextBlock x:Name="Total" FontSize="32" FontWeight="SemiBold" />
          <TextBlock x:Name="Scope" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
          </StackPanel>
          <ComboBox x:Name="ChartSource" Width="270" SelectionChanged="ChartSourceChanged">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="views:PowerChartChoice">
                <TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </views:InlineWrapPanel>
        <Border CornerRadius="12" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
          <Grid Padding="8,8,8,0" Height="280">
            <lvc:CartesianChart x:Name="Chart" Visibility="Collapsed" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                LegendPosition="Hidden" TooltipPosition="Top" FindingStrategy="CompareOnlyXTakeClosest" AnimationsSpeed="0:0:0" />
            <TextBlock x:Name="WaitMessage" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
          </Grid>
        </Border>
          <TextBlock x:Name="WindowLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Spacing="8">
        <TextBlock x:Name="SensorsHeading" FontSize="18" FontWeight="SemiBold" />
        <Grid ColumnSpacing="12" Padding="8,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="82" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
          <TextBlock x:Name="DeviceHeading" />
          <TextBlock x:Name="ValueHeading" Grid.Column="1" HorizontalAlignment="Right" />
          <TextBlock x:Name="IncludedHeading" Grid.Column="2" HorizontalAlignment="Center" />
        </Grid>
        <ItemsControl x:Name="Sensors">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="views:PowerSensorRow">
              <Grid ColumnSpacing="12" Padding="8,6" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="82" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                  <TextBlock Text="{x:Bind Device}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Device}" />
                  <TextBlock Text="{x:Bind Sensor}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Sensor}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{x:Bind Value}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{x:Bind Included}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
  </Grid>
</UserControl>
