<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Dwell.ico</ApplicationIcon>
    <Version>0.6.15</Version>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <DefaultLanguage>ru-RU</DefaultLanguage>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Dwell.Core/Dwell.Core.csproj" />
    <!-- WinUI integrations transitively reference the older monolithic SDK package. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250606001" ExcludeAssets="all" PrivateAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260803003" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WinUI" Version="2.0.5" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="HidSharp" Version="2.6.4" GeneratePathProperty="true" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.15" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <Content Update="Assets/Dwell.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="Assets/Dwell.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="HardwareSensorNotices.txt" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(PkgHidSharp)/LICENSE.txt" Link="HidSharp-LICENSE.txt" CopyToPublishDirectory="PreserveNewest" Condition="'$(PkgHidSharp)' != ''" />
    <Content Include="Mono-LICENSE.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="IncludeWinUIResourcesInPublish" BeforeTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(TargetDir)$(AssemblyName).pri">
        <RelativePath>$(AssemblyName).pri</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <_DwellXbf Include="$(TargetDir)**/*.xbf" />
      <ResolvedFileToPublish Include="@(_DwellXbf)" RelativePath="%(_DwellXbf.RecursiveDir)%(_DwellXbf.Filename)%(_DwellXbf.Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
